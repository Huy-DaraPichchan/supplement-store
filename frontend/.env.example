# Frontend environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Do not commit .env.local. It is ignored by Git.

# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------
# The local FastAPI backend started from the backend directory.
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Production hosting on Vercel
# -----------------------------------------------------------------------------
# Do not put production secrets in this file.
# In Vercel, open Project Settings -> Environment Variables and add:
#
#   BACKEND_URL=https://your-api.fastapicloud.dev
#
# Enable the variable for Production, then redeploy the frontend.
#
# The frontend sends API requests to /api/backend/* and Next.js forwards them
# to the backend URL above. No NEXT_PUBLIC_API_URL is required.
#
# BACKEND_URL=https://your-api.fastapicloud.dev
