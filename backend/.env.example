# =========================
# Application
# =========================
APP_NAME=ecommerce-supplement-api
APP_ENV=development
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000


# =========================
# Database
# =========================
# Use sqlite for local development or postgresql for Supabase hosting.
DATABASE_BACKEND=sqlite
SQLITE_PATH=./ecommerce.db
# Required only when DATABASE_BACKEND=postgresql. Use the Supabase session pooler URL.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ecommerce


# =========================
# JWT Authentication
# =========================
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# =========================
# Supabase Storage
# =========================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-server-side-supabase-key
SUPABASE_STORAGE_BUCKET=product-images
